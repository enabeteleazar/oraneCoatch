{
  "include": ["src/**/*", "shared/**/*", "api/**/*", "vite.config.ts", "vite-api-dev.ts"],
  "exclude": ["node_modules", "build", "dist", "src/components/Contact.tsx", "src/components/ui/**", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
